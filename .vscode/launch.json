{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run SentiPulse (All Services)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/start-all.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Backend Only (Port 8000)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/backend/server.js"
    }
  ]
}
